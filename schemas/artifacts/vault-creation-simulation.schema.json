{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/IPOR-Labs/ipor-fusion/schemas/artifacts/vault-creation-simulation.schema.json",
    "title": "IPOR Fusion vault creation simulation report",
    "description": "Result of executing one vault creation plan on an ephemeral Anvil fork.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "status",
        "kind",
        "chainId",
        "deploymentId",
        "fork",
        "plan",
        "transaction",
        "result",
        "provider",
        "warnings",
        "references"
    ],
    "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "status": { "type": "string", "enum": ["success", "reverted", "unverified"] },
        "kind": { "type": "string", "enum": ["vault-creation-simulation"] },
        "chainId": { "type": "integer", "minimum": 1 },
        "deploymentId": { "$ref": "#/$defs/id" },
        "fork": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "blockNumber", "blockHash", "broadcast"],
            "properties": {
                "engine": { "type": "string", "enum": ["anvil"] },
                "blockNumber": { "type": "integer", "minimum": 0 },
                "blockHash": { "$ref": "#/$defs/hash" },
                "broadcast": { "type": "boolean", "enum": [false] }
            }
        },
        "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "inputSha256"],
            "properties": {
                "path": { "$ref": "#/$defs/path" },
                "sha256": { "$ref": "#/$defs/hash" },
                "inputSha256": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" }
            }
        },
        "transaction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "from", "value", "localHash"],
            "properties": {
                "to": { "$ref": "#/$defs/address" },
                "from": { "$ref": "#/$defs/address" },
                "value": { "type": "string", "enum": ["0"] },
                "localHash": { "$ref": "#/$defs/hash" }
            }
        },
        "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "succeeded",
                "gasUsed",
                "logCount",
                "revertReason",
                "created",
                "creationEvent",
                "verification"
            ],
            "properties": {
                "succeeded": { "type": "boolean" },
                "gasUsed": { "type": "integer", "minimum": 0 },
                "logCount": { "type": "integer", "minimum": 0 },
                "revertReason": { "$ref": "#/$defs/revert" },
                "created": { "$ref": "#/$defs/created" },
                "creationEvent": { "$ref": "#/$defs/creationEvent" },
                "verification": { "$ref": "#/$defs/verification" }
            }
        },
        "provider": { "$ref": "#/$defs/provider" },
        "warnings": { "$ref": "#/$defs/messages" },
        "references": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest", "abi"],
            "properties": {
                "manifest": { "type": ["string", "null"], "minLength": 1 },
                "abi": { "type": ["string", "null"], "minLength": 1 }
            }
        }
    },
    "$defs": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "minLength": 1 },
        "messages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variable"],
            "properties": { "variable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
        },
        "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "ok", "observed", "expected"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "ok": { "type": "boolean" },
                "observed": { "type": "string" },
                "expected": { "type": "string" }
            }
        },
        "revert": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["data", "kind", "selector", "signature", "name", "arguments", "declaredIn", "text", "note"],
            "properties": {
                "data": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]*$" },
                "kind": { "type": "string", "enum": ["custom-error", "error-string", "panic", "unknown", "empty"] },
                "selector": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{8}$" },
                "signature": { "type": ["string", "null"] },
                "name": { "type": ["string", "null"] },
                "arguments": { "type": "array", "items": { "type": "string" } },
                "declaredIn": { "type": "array", "items": { "type": "string" } },
                "text": { "type": "string", "minLength": 1 },
                "note": { "type": ["string", "null"] }
            }
        },
        "created": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
                "index",
                "version",
                "assetName",
                "assetSymbol",
                "assetDecimals",
                "underlyingToken",
                "underlyingTokenSymbol",
                "underlyingTokenDecimals",
                "initialOwner",
                "plasmaVault",
                "plasmaVaultBase",
                "accessManager",
                "feeManager",
                "rewardsManager",
                "withdrawManager",
                "contextManager",
                "priceManager"
            ],
            "properties": {
                "index": { "$ref": "#/$defs/decimal" },
                "version": { "$ref": "#/$defs/decimal" },
                "assetName": { "type": "string", "minLength": 1 },
                "assetSymbol": { "type": "string", "minLength": 1 },
                "assetDecimals": { "$ref": "#/$defs/decimal" },
                "underlyingToken": { "$ref": "#/$defs/address" },
                "underlyingTokenSymbol": { "type": "string", "minLength": 1 },
                "underlyingTokenDecimals": { "$ref": "#/$defs/decimal" },
                "initialOwner": { "$ref": "#/$defs/address" },
                "plasmaVault": { "$ref": "#/$defs/address" },
                "plasmaVaultBase": { "$ref": "#/$defs/address" },
                "accessManager": { "$ref": "#/$defs/address" },
                "feeManager": { "$ref": "#/$defs/address" },
                "rewardsManager": { "$ref": "#/$defs/address" },
                "withdrawManager": { "$ref": "#/$defs/address" },
                "contextManager": { "$ref": "#/$defs/address" },
                "priceManager": { "$ref": "#/$defs/address" }
            }
        },
        "creationEvent": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["signature", "topic", "emitter", "index", "version", "initialOwner", "plasmaVault", "plasmaVaultBase", "feeManager"],
            "properties": {
                "signature": { "type": "string", "minLength": 1 },
                "topic": { "$ref": "#/$defs/hash" },
                "emitter": { "$ref": "#/$defs/address" },
                "index": { "$ref": "#/$defs/decimal" },
                "version": { "$ref": "#/$defs/decimal" },
                "initialOwner": { "$ref": "#/$defs/address" },
                "plasmaVault": { "$ref": "#/$defs/address" },
                "plasmaVaultBase": { "$ref": "#/$defs/address" },
                "feeManager": { "$ref": "#/$defs/address" }
            }
        },
        "verification": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["ok", "checks", "readings"],
            "properties": {
                "ok": { "type": "boolean" },
                "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
                "readings": { "type": "object" }
            }
        }
    }
}
