{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/IPOR-Labs/ipor-fusion/schemas/artifacts/vault-creation-plan.schema.json",
    "title": "IPOR Fusion vault creation plan",
    "description": "Unsigned plan produced by vault:plan for one call to a verified FusionFactory deployment.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "status",
        "kind",
        "chainId",
        "deploymentId",
        "readBlock",
        "input",
        "transaction",
        "expected",
        "provider",
        "warnings",
        "references"
    ],
    "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "status": { "type": "string", "enum": ["planned"] },
        "kind": { "type": "string", "enum": ["vault-creation"] },
        "chainId": { "type": "integer", "minimum": 1 },
        "deploymentId": { "$ref": "#/$defs/id" },
        "readBlock": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "hash"],
            "properties": {
                "number": { "type": "integer", "minimum": 0 },
                "hash": { "$ref": "#/$defs/hash" }
            }
        },
        "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
                "path": { "$ref": "#/$defs/path" },
                "sha256": { "$ref": "#/$defs/hash" }
            }
        },
        "transaction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "from", "value", "data", "operation", "arguments"],
            "properties": {
                "to": { "$ref": "#/$defs/address" },
                "from": { "$ref": "#/$defs/address" },
                "value": { "type": "string", "enum": ["0"] },
                "data": { "type": "string", "minLength": 10, "pattern": "^0x(?:[0-9a-fA-F]{2})+$" },
                "operation": { "type": "string", "minLength": 1 },
                "arguments": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "assetName",
                        "assetSymbol",
                        "underlyingToken",
                        "redemptionDelayInSeconds",
                        "owner",
                        "daoFeePackageIndex"
                    ],
                    "properties": {
                        "assetName": { "type": "string", "minLength": 1 },
                        "assetSymbol": { "type": "string", "minLength": 1 },
                        "underlyingToken": { "$ref": "#/$defs/address" },
                        "redemptionDelayInSeconds": { "$ref": "#/$defs/decimal" },
                        "owner": { "$ref": "#/$defs/address" },
                        "daoFeePackageIndex": { "$ref": "#/$defs/decimal" }
                    }
                }
            }
        },
        "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["implementation", "factoryVersion", "feePackage"],
            "properties": {
                "implementation": { "$ref": "#/$defs/address" },
                "factoryVersion": { "$ref": "#/$defs/decimal" },
                "feePackage": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "source",
                        "index",
                        "managementFeeBps",
                        "performanceFeeBps",
                        "feeRecipient"
                    ],
                    "properties": {
                        "source": { "type": "string", "enum": ["dao-global", "business-client"] },
                        "index": { "type": "integer", "minimum": 0 },
                        "managementFeeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
                        "performanceFeeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
                        "feeRecipient": { "$ref": "#/$defs/address" }
                    }
                }
            }
        },
        "provider": { "$ref": "#/$defs/provider" },
        "warnings": { "$ref": "#/$defs/messages" },
        "references": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest", "abi", "verificationReport"],
            "properties": {
                "manifest": { "$ref": "#/$defs/path" },
                "abi": { "$ref": "#/$defs/path" },
                "verificationReport": { "type": ["string", "null"], "minLength": 1 }
            }
        }
    },
    "$defs": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "minLength": 1 },
        "messages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variable"],
            "properties": { "variable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
        }
    }
}
