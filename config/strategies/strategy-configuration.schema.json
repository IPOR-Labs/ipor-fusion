{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/IPOR-Labs/ipor-fusion/config/strategies/strategy-configuration.schema.json",
    "title": "IPOR Fusion strategy configuration input",
    "description": "Configuration of exactly one catalogued integration on one already created vault. Operators are addresses that will hold the roles; the market limit is a decimal string in WAD, where 1000000000000000000 is 100% of the vault's assets.",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "chainId", "catalogId", "operators", "market", "pricedAssets"],
    "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "chainId": { "type": "integer", "minimum": 1 },
        "catalogId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "operators": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "atomist", "fuseManager", "alpha"],
            "properties": {
                "owner": { "$ref": "#/$defs/address" },
                "atomist": { "$ref": "#/$defs/address" },
                "fuseManager": { "$ref": "#/$defs/address" },
                "alpha": { "$ref": "#/$defs/address" }
            }
        },
        "market": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "limitInPercentageWad", "substrates"],
            "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "limitInPercentageWad": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
                "substrates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["address", "label"],
                        "properties": {
                            "address": { "$ref": "#/$defs/address" },
                            "label": { "type": "string", "minLength": 1 }
                        }
                    }
                }
            }
        },
        "pricedAssets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/address" } }
    },
    "$defs": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
    }
}
