{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/IPOR-Labs/ipor-fusion/evals/agent-readiness/results.schema.json",
    "title": "Agent-readiness run record",
    "description": "One machine-readable record per run of the eight-task suite. The conditions are part of the record because a run made under different conditions is not comparable, and the difference must be visible rather than attributed to the repository.",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "runId", "date", "conditions", "fixtures", "results"],
    "properties": {
        "schemaVersion": { "type": "integer", "enum": [1] },
        "runId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "label": { "type": "string", "minLength": 1 },
        "conditions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commit", "model", "toolsAvailable", "workBudgetMinutes", "networkAccess", "memoryMode", "repeats"],
            "properties": {
                "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
                "model": { "type": "string", "minLength": 1 },
                "toolsAvailable": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "workBudgetMinutes": { "type": "integer", "minimum": 1 },
                "networkAccess": { "type": "string", "enum": ["none", "rpc-only", "rpc-and-web"] },
                "memoryMode": {
                    "type": "string",
                    "description": "none = no private knowledge base and no personal CLAUDE.md. A run with private memory is recorded and reported separately, never as a repository baseline.",
                    "enum": ["none", "private-memory"]
                },
                "repeats": { "type": "integer", "minimum": 1 }
            }
        },
        "fixtures": {
            "type": "object",
            "additionalProperties": { "type": ["string", "null"] }
        },
        "results": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["task", "score", "metrics"],
                "properties": {
                    "task": { "type": "string", "pattern": "^E[1-8]$" },
                    "score": {
                        "type": "string",
                        "description": "blocked = the agent correctly reported a missing prerequisite instead of guessing. It is not a pass and it is not a failure of the repository.",
                        "enum": ["pass", "fail", "blocked"]
                    },
                    "blockedBy": { "type": ["string", "null"] },
                    "hardFail": { "type": ["string", "null"] },
                    "notes": { "type": ["string", "null"] },
                    "metrics": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["humanInterventions", "costTokens", "evidenceQuality"],
                        "properties": {
                            "timeToFirstRelevantTestMinutes": { "type": ["number", "null"], "minimum": 0 },
                            "humanInterventions": { "type": "integer", "minimum": 0 },
                            "costTokens": { "type": "integer", "minimum": 0 },
                            "redundantReads": { "type": ["integer", "null"], "minimum": 0 },
                            "evidenceQuality": { "type": "integer", "minimum": 0, "maximum": 3 }
                        }
                    }
                }
            }
        }
    }
}
